# Supabase Free Tier Configuration
# Get these values from your Supabase Dashboard: Project Settings -> API
# Note: The anon key is public and designed to be exposed in frontend applications.
# Row Level Security (RLS) policies enforce that only the authenticated owner can write data.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here
